{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{db.json,public/index.html}"
    }
  },
  "redirects": [
    { "source": "/", "destination": "/public/login.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/:recurso(usuarios|automoveis|pedidos|contratos)", "destination": "/api" },
    { "source": "/:recurso(usuarios|automoveis|pedidos|contratos)/:resto*", "destination": "/api" }
  ]
}
